rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Identity & Role Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Owner email must be verified (Google sign-in is verified automatically)
    function isVerifiedOwnerEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'amalalhasan2006@gmail.com';
    }

    // Trusted Role checks
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['super-admin', 'super_admin', 'admin'] ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isVerifiedOwnerEmail()
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['super-admin', 'super_admin'] ||
        isVerifiedOwnerEmail()
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'teacher' ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- System Initialization Lock ---
    match /system_config/{configId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- Users Profiles (Strictly isolated by Firebase Auth UID) ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isTeacher() || isAdmin();
      allow list: if isAdmin() || (isTeacher() && resource.data.assignedTeacherId == request.auth.uid);

      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == 'student' &&
        request.resource.data.id == userId
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.points == resource.data.points &&
        request.resource.data.mainLevel == resource.data.mainLevel &&
        request.resource.data.currentStage == resource.data.currentStage &&
        request.resource.data.subscriptionStatus == resource.data.subscriptionStatus &&
        request.resource.data.assignedTeacherId == resource.data.assignedTeacherId
      );

      allow delete: if isAdmin();
    }

    // --- Admins collection ---
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // --- Teachers collection ---
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Admission Registration Requests ---
    match /registration_requests/{requestId} {
      allow create: if request.resource.data.status == 'pending' && isValidId(requestId);
      allow get, list, update, delete: if isAdmin();
    }

    // --- Student Homework Assignments ---
    match /homework/{homeworkId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- Student Homework Submissions ---
    match /student_homework_submissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() || (isOwner(resource.data.studentId) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // --- Student Grades and Test Records ---
    match /grades/{gradeId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- English Zone Stars Audit Log ---
    match /points_log/{pointsId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- Timetable Sessions ---
    match /timetable/{sessionId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- Academy Public Configurations ---
    match /academy_settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- Dynamic Content Management Collections ---
    match /website_content/{contentId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /library_materials/{materialId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /promotions_offers/{offerId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Connection test collection ---
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
