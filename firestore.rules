rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin: server-verified Custom Claims OR a document created manually from the Firebase Console
    function isAdminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Teacher document: /teachers is writable only by admins
    function isTeacherDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['super-admin', 'super_admin'] ||
        (
          isAdminDoc() && (
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') in ['super-admin', 'super_admin'] ||
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('isSuperAdmin', false) == true
          )
        )
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['super-admin', 'super_admin', 'admin'] ||
        request.auth.token.admin == true ||
        isAdminDoc()
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'teacher' ||
        isTeacherDoc()
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- System Initialization Lock ---
    match /system_config/{configId} {
      allow get: if configId == 'initialization_lock';
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- Users Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isTeacher() || isAdmin();
      allow list: if isAdmin() || (isTeacher() && resource.data.assignedTeacherId == request.auth.uid);

      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.points == 0 &&
        request.resource.data.subscriptionStatus == 'pending' &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.keys().hasOnly([
          'id', 'email', 'fullName', 'role', 'phone', 'country', 'age',
          'avatarUrl', 'avatarConfig', 'createdAt', 'points', 'mainLevel',
          'currentStage', 'subscriptionStatus', 'learningFormat',
          'starOfTheWeekCount', 'starOfTheMonthCount'
        ])
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'country', 'age', 'avatarUrl', 'avatarConfig', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    // --- Admins collection: no client can write; documents are created from the Firebase Console only ---
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- Teachers collection ---
    match /teachers/{teacherId} {
      allow get, list: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // --- Admission Registration Requests ---
    match /registration_requests/{requestId} {
      allow create:
        if request.resource.data.status == 'pending' &&
        isValidId(requestId) &&
        request.resource.data.keys().hasOnly([
          'id', 'fullName', 'age', 'country', 'whatsappNumber', 'email',
          'mainLevel', 'learningGoal', 'learningFormat', 'notes', 'status', 'submittedAt'
        ]) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 150 &&
        request.resource.data.whatsappNumber is string && request.resource.data.whatsappNumber.size() <= 40;

      allow get, list, update, delete: if isAdmin();
    }

    // --- Student Homework Assignments ---
    match /homework/{homeworkId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- Student Homework Submissions ---
    match /student_homework_submissions/{submissionId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() || (isOwner(resource.data.studentId) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // --- Student Grades and Test Records ---
    match /grades/{gradeId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- English Zone Stars Audit Log ---
    match /points_log/{pointsId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- Timetable Sessions ---
    match /timetable/{sessionId} {
      allow get, list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    // --- Academy Public Configurations ---
    match /academy_settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- Dynamic Content Management Collections ---
    match /website_content/{contentId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /library_materials/{materialId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /promotions_offers/{offerId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow get, list: if resource.data.isApproved == true || isAdmin();

      allow create: if isSignedIn() &&
        request.resource.data.isApproved == false &&
        request.resource.data.keys().hasOnly([
          'id', 'studentNameEn', 'studentNameAr', 'roleEn', 'roleAr',
          'level', 'quoteEn', 'quoteAr', 'rating', 'isApproved', 'submittedAt'
        ]) &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.quoteEn is string && request.resource.data.quoteEn.size() <= 1000;

      allow update, delete: if isAdmin();
    }

    function isValidFeedbackScreenshot(data) {
      return data.keys().hasOnly([
        'id', 'imageDataUrl', 'category', 'captionEn', 'captionAr',
        'orderIndex', 'isPublished', 'hasPrivacyMask', 'createdAt', 'updatedAt', 'createdBy'
      ]) &&
      data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
      data.imageDataUrl is string && data.imageDataUrl.size() > 0 && data.imageDataUrl.size() <= 950000 &&
      data.category is string && data.category in ['none', 'student_reviews', 'parents_feedback', 'lecture_feedback', 'course_experience'] &&
      (!('captionEn' in data) || (data.captionEn is string && data.captionEn.size() <= 200)) &&
      (!('captionAr' in data) || (data.captionAr is string && data.captionAr.size() <= 200)) &&
      (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60)) &&
      (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120)) &&
      data.orderIndex is number &&
      data.isPublished is bool &&
      data.hasPrivacyMask is bool &&
      data.createdAt is string && data.createdAt.size() <= 60;
    }

    match /feedback_screenshots/{screenshotId} {
      allow get, list: if resource.data.isPublished == true || isAdmin();
